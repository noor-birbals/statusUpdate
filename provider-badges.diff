   const raw = await fs.readFile(DATA_FILE, 'utf-8');
   try {
     const parsed = JSON.parse(raw);
-    return Array.isArray(parsed) ? parsed : [];
+    return Array.isArray(parsed) ? parsed.map(normalizeStatus) : [];
   } catch {
     return [];
   }
